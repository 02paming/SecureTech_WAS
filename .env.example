# 복사해서 .env로 저장한 뒤 실제 값을 넣습니다
DEBUG=False
DJANGO_SECRET_KEY=
DB_PASSWORD=
DISCORD_WEBHOOK_URL=
# 8080번 백엔드 주소 (엔진으로 정책을 전달, AI 서버까지 경유)
